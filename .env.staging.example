# KAN-31 scaffolding. These are placeholders documenting which variables the
# staging environment needs — not real credentials. Actual values are set as
# Railway environment variables once the staging Railway project/environment
# is provisioned (see gmleads-agents/context/adr/ for the deployment design).
# Isolation requirement (KAN-31 AC): staging must use its own Postgres/Redis
# plugin instances, never the ones production or local use.
#
# NOTE: gmleads-dashboard is backend-API-only today (three JSON endpoints,
# no frontend — see PROJECT_STATUS_JULY_2026.md). It is deployed like the
# other backend services (Railway/GHCR), not to Vercel — architecture.md's
# "Dashboard: Vercel Pro" entry refers to the future Next.js frontend
# (KAN-100), which doesn't exist yet. Revisit this once KAN-100 lands.
# This service is internal-only for now — no public hostname of its own.

NODE_ENV=staging
PORT=3006

DATABASE_URL=          # Railway Postgres plugin connection string (staging project)
REDIS_URL=             # Railway Redis plugin connection string (staging project)

# Per-user dashboard JWT signing secret (KAN-99, see ADR-013 — supersedes
# ADR-004's shared-secret bearer token, resolves KAN-32). Must be identical
# to the value set in gmleads-gateway for this environment. Generate a real
# random value per environment.
DASHBOARD_JWT_SECRET=

FEAT_IDENTIFICATION=true
FEAT_ICP_SCORING=true
FEAT_SLACK_CHAT=true
FEAT_SLACK_ALERTS=true
FEAT_CALENDAR_BOOKING=true
FEAT_AI_CONVERSATION=false
FEAT_RATE_LIMITING=true   # per architecture.md's environment matrix: on in staging+prod
