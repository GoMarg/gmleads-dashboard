# Local dev — copy to .env.local (gitignored). Points the frontend at the
# gateway running locally (see gmleads-infra/docker-compose.yml, port 13000)
# or at `npm run dev` in gmleads-gateway directly (port 3000).
NEXT_PUBLIC_API_URL=http://localhost:13000

# Also required for `npm install` to succeed at all — @gomarg/shared-schemas
# is a real published package (GitHub Packages), and .npmrc needs a token
# to authenticate the @gomarg scope even for a local install. A personal
# fine-grained PAT scoped to read-only Packages access on gmleads-shared
# works fine; export it in your shell rather than committing it here.
# GITHUB_PACKAGES_READ_TOKEN=
