# Placeholders documenting which variables the staging environment
# needs — not real credentials. Actual values are set as Vercel project
# environment variables. See ../DEPLOYMENT.md for the full picture. No
# staging environment is actually provisioned yet (see gmleads-agents'
# DEPLOYMENT.md) — this documents intent for when one is.
#
# This app is genuinely stateless client-side (see ADR-014, Option B): no
# server-side session, no cookies. Its only external dependency is
# @gomarg/shared-schemas, a published npm package (GitHub Packages) — no
# sibling-repo checkout involved.

# Public — bundled into client JS, visible to any visitor. Never put a
# secret in a NEXT_PUBLIC_ var. Points at the staging gateway (Railway).
NEXT_PUBLIC_API_URL=

# Build-time only (read by .npmrc to authenticate the @gomarg scope against
# GitHub Packages) — never exposed to the browser bundle since it isn't
# prefixed NEXT_PUBLIC_, and never read at runtime by any app code. Same
# token as production can be reused (it's read-only) or a separate one
# scoped identically — see ../DEPLOYMENT.md.
GITHUB_PACKAGES_READ_TOKEN=
